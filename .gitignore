# Dados baixados — não commitar
dataset_analysis/data/persona-1m/
!dataset_analysis/data/persona-1m/.gitkeep
dataset_analysis/data/schema/dimensions.json
dataset_analysis/data/schema/persona_codes.schema.json

# Ambiente virtual gerenciado pelo uv (um por subprojeto)
.venv/
**/.venv/

# Python
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Outputs (comentado por padrão — o pesquisador decide se commita)
# dataset_analysis/outputs/*.json
# dataset_analysis/outputs/*.md
# debate_simulation/outputs/*.json
# debate_simulation/outputs/*.md

# Execuções do experimento (manifest + records por turno). Descomentar para
# não versionar; os dados do experimento final provavelmente devem ser
# commitados deliberadamente, como o conjunto de personas.
# debate_simulation/experiments/

# Árvores de análise: derivadas de experiments/ e regeneráveis a qualquer
# momento com scripts/build_analysis.py. Não versionar — os symlinks quebram
# fora desta máquina, e o modo --copy só duplicaria o que já está em
# experiments/.
debate_simulation/analysis/runs/

# Variáveis de ambiente (chaves de API do motor de LLM em debate_simulation/)
.env
**/.env
