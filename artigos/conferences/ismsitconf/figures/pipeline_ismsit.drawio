ter=0;" edge="1" parent="1" source="card-65" target="card-67"><mxGeometry relative="1" as="geometry"><mxPoint x="688.03" y="758.23" as="sourcePoint"/><mxPoint x="734.08" y="758.23" as="targetPoint"/></mxGeometry></mxCell><mxCell id="txt-85" value='&lt;img src="data:image/svg+xml;base64," style="width:12.0px;height:12.0px;vertical-align:-1.5px;"&gt;&amp;nbsp;&lt;b&gt;History:&lt;/b&gt; later turns respond to the published version (divergent histories)' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=12.0;fontColor=#6F6F6F;fontStyle=0;fillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="108.28" y="501.95" width="415.10" height="20.40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>