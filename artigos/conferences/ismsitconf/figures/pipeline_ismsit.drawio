" y="20.77" width="28.40" height="59.75" as="geometry"/></mxCell><mxCell id="blabel-7" value="DEBATERS" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.4;horizontal=0;html=1;whiteSpace=wrap;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="11.41" y="103.85" width="28.40" height="136.57" as="geometry"/></mxCell><mxCell id="blabel-8" value="PROSPECTIVE&lt;br&gt;MODERATION" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.4;horizontal=0;html=1;whiteSpace=wrap;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="3.21" y="270.30" width="44.80" height="250.38" as="geometry"/></mxCell><mxCell id="blabel-9" value="EVALUATION" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.4;horizontal=0;html=1;whiteSpace=wrap;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="11.41" y="550.56" width="28.40" height="113.81" as="geometry"/></mxCell><mxCell id="blabel-10" value="THE LENS" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.4;horizontal=0;html=1;whiteSpace=wrap;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="11.41" y="691.40" width="28.40" height="119.50" as="geometry"/></mxCell><mxCell id="panel-11" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#E5E7EB;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="813.75" y="113.81" width="173.56" height="122.35" as="geometry"/></mxCell><mxCell id="panel-12" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#E5E7EB;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="372.73" y="310.14" width="449.55" height="179.25" as="geometry"/></mxCell><mxCell id="role-13" value="" style="ellipse;aspect=fixed;fillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;html=1;" vertex="1" parent="1"><mxGeometry x="52.47" y="20.04" width="31.63" height="31.63" as="geometry"/></mxCell><mxCell id="icon-14" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;editableCssRules=.*;image=data:image/svg+xml,;" vertex="1" parent="role-13"><mxGeometry x="7.06" y="8.81" width="17.50" height="14.00" as="geometry"/></mxCell><mxCell id="txt-15" value="Debater agent (LLM)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="84.10" y="25.17" width="134.09" height="21.36" as="geometry"/></mxCell><mxCell id="role-16" value="" style="ellipse;aspect=fixed;fillColor=#DCE6F4;strokeColor=#22385C;strokeWidth=0.9;html=1;" vertex="1" parent="1"><mxGeometry x="243.11" y="20.04" width="31.63" height="31.63" as="geometry"/></mxCell><mxCell id="icon-17" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;editableCssRules=.*;image=data:image/svg+xml,;" vertex="1" parent="role-16"><mxGeometry x="7.94" y="8.81" width="15.76" height="14.01" as="geometry"/></mxCell><mxCell id="txt-18" value="Prospective moderator (LLM)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="274.73" y="25.17" width="181.73" height="21.36" as="geometry"/></mxCell><mxCell id="role-19" value="" style="ellipse;aspect=fixed;fillColor=#E3F0DA;strokeColor=#22385C;strokeWidth=0.9;html=1;" vertex="1" parent="1"><mxGeometry x="487.80" y="20.04" width="31.63" height="31.63" as="geometry"/></mxCell><mxCell id="icon-20" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;editableCssRules=.*;image=data:image/svg+xml,;" vertex="1" parent="role-19"><mxGeometry x="7.06" y="8.81" width="17.50" height="14.00" as="geometry"/></mxCell><mxCell id="txt-21" value="Blind evaluator (LLM)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="519.43" y="25.17" width="137.64" height="21.36" as="geometry"/></mxCell><mxCell id="e-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9.6;strokeWidth=2.4;strokeColor=#8B4A2B;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54.06" y="68.29" as="sourcePoint"/><mxPoint x="82.51" y="68.29" as="targetPoint"/></mxGeometry></mxCell><mxCell id="txt-23" value="Persona data" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="84.79" y="57.61" width="92.13" height="21.36" as="geometry"/></mxCell><mxCell id="e-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9.6;strokeWidth=2.4;strokeColor=#2E5E8C;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="196.32" y="68.29" as="sourcePoint"/><mxPoint x="224.78" y="68.29" as="targetPoint"/></mxGeometry></mxCell><mxCell id="txt-25" value="Agent prompt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="227.05" y="57.61" width="92.84" height="21.36" as="geometry"/></mxCell><mxCell id="e-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9.6;strokeWidth=2.4;strokeColor=#E8913A;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="338.59" y="68.29" as="sourcePoint"/><mxPoint x="367.04" y="68.29" as="targetPoint"/></mxGeometry></mxCell><mxCell id="txt-27" value="Candidate message" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="369.32" y="57.61" width="129.83" height="21.36" as="geometry"/></mxCell><mxCell id="e-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9.6;strokeWidth=2.4;strokeColor=#4E9A3A;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.69" y="68.29" as="sourcePoint"/><mxPoint x="549.14" y="68.29" as="targetPoint"/></mxGeometry></mxCell><mxCell id="txt-29" value="Published message" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="551.42" y="57.61" width="127.69" height="21.36" as="geometry"/></mxCell><mxCell id="e-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9.6;strokeWidth=2.4;strokeColor=#C8385A;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="702.78" y="68.29" as="sourcePoint"/><mxPoint x="731.24" y="68.29" as="targetPoint"/></mxGeometry></mxCell><mxCell id="txt-31" value="Scores and records" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="733.51" y="57.61" width="126.98" height="21.36" as="geometry"/></mxCell><mxCell id="e-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9.6;strokeWidth=2.4;strokeColor=#6F6F6F;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890.57" y="68.29" as="sourcePoint"/><mxPoint x="919.03" y="68.29" as="targetPoint"/></mxGeometry></mxCell><mxCell id="txt-33" value="History" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="921.30" y="57.61" width="55.82" height="21.36" as="geometry"/></mxCell><mxCell id="card-34" value='&lt;img src="data:image/svg+xml;base64," style="width:11.2px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&amp;nbsp;Synthetic personas' style="swimlane;html=1;whiteSpace=wrap;startSize=24.95;fillColor=#22385C;swimlaneFillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="59.75" y="113.81" width="175.88" height="91.86" as="geometry"/></mxCell><mxCell id="body-35" value="Structured dataset of synthetic personas described along categorical dimensions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-34"><mxGeometry x="0.00" y="24.95" width="175.88" height="66.90" as="geometry"/></mxCell><mxCell id="card-36" value='&lt;img src="data:image/svg+xml;base64," style="width:12.8px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&amp;nbsp;Classification rule' style="swimlane;html=1;whiteSpace=wrap;startSize=23.92;fillColor=#22385C;swimlaneFillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="258.92" y="113.81" width="181.57" height="93.19" as="geometry"/></mxCell><mxCell id="body-37" value="Explicit and auditable: antagonistic pairs composed in a reproducible and traceable way" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-36"><mxGeometry x="0.00" y="23.92" width="181.57" height="69.27" as="geometry"/></mxCell><mxCell id="card-38" value='&lt;img src="data:image/svg+xml;base64," style="width:12.8px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&amp;nbsp;Agent prompt' style="swimlane;html=1;whiteSpace=wrap;startSize=24.94;fillColor=#22385C;swimlaneFillColor=#DCE6F4;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="463.78" y="113.81" width="318.14" height="127.22" as="geometry"/></mxCell><mxCell id="body-39" value="&lt;b&gt;Identity:&lt;/b&gt; the persona’s positions; the political label stays in the researchers’ records and is withheld from the agent (&lt;i&gt;positions, not labels&lt;/i&gt;)&lt;br&gt;&lt;b&gt;Behavior:&lt;/b&gt; Angenot’s pathologies provoked, not assumed, with calibrated escalation · attacks on identity excluded (hate speech is a different object)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-38"><mxGeometry x="0.00" y="24.94" width="318.14" height="102.28" as="geometry"/></mxCell><mxCell id="tab-40" value="Debater agents" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.8;html=1;whiteSpace=nowrap;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="836.69" y="102.06" width="127.69" height="23.51" as="geometry"/></mxCell><mxCell id="role-41" value="" style="ellipse;aspect=fixed;fillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;html=1;" vertex="1" parent="1"><mxGeometry x="834.64" y="134.70" width="49.27" height="49.27" as="geometry"/></mxCell><mxCell id="icon-42" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;editableCssRules=.*;image=data:image/svg+xml,;" vertex="1" parent="role-41"><mxGeometry x="9.63" y="12.63" width="30.00" height="24.00" as="geometry"/></mxCell><mxCell id="txt-43" value="Pole A" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=12.8;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="831.36" y="185.11" width="55.83" height="21.36" as="geometry"/></mxCell><mxCell id="role-44" value="" style="ellipse;aspect=fixed;fillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;html=1;" vertex="1" parent="1"><mxGeometry x="917.15" y="134.70" width="49.27" height="49.27" as="geometry"/></mxCell><mxCell id="icon-45" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;editableCssRules=.*;image=data:image/svg+xml,;" vertex="1" parent="role-44"><mxGeometry x="9.63" y="12.63" width="30.00" height="24.00" as="geometry"/></mxCell><mxCell id="txt-46" value="Pole B" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=12.8;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="913.87" y="185.11" width="55.83" height="21.36" as="geometry"/></mxCell><mxCell id="txt-47" value="polarized and antagonistic" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="818.18" y="209.54" width="164.70" height="21.36" as="geometry"/></mxCell><mxCell id="box-48" value='&lt;img src="data:image/svg+xml;base64," style="width:16.0px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&lt;b&gt;Debater&lt;/b&gt;&lt;br&gt;on its turn, receives the published history and writes a candidate' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;align=left;verticalAlign=middle;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontSize=12.8;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="71.13" y="278.84" width="118.98" height="100.29" as="geometry"/></mxCell><mxCell id="box-49" value="&lt;b&gt;Candidate message&lt;/b&gt;&lt;br&gt;not yet published" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8913A;strokeWidth=2;align=left;verticalAlign=middle;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontSize=12.8;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="204.86" y="278.84" width="97.31" height="73.13" as="geometry"/></mxCell><mxCell id="box-50" value='&lt;img src="data:image/svg+xml;base64," style="width:14.4px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&lt;b&gt;Published&lt;/b&gt;&lt;br&gt;&lt;b&gt;message&lt;/b&gt;&lt;br&gt;enters the debate history' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E9A3A;strokeWidth=2;align=left;verticalAlign=middle;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontSize=12.8;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="845.05" y="278.84" width="142.84" height="73.13" as="geometry"/></mxCell><mxCell id="box-51" value="&lt;b&gt;Controlled comparison:&lt;/b&gt; the same debaters in debates with and without moderation; only the moderator differs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0DA;strokeColor=#22385C;strokeWidth=0.9;align=left;verticalAlign=middle;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontSize=12.8;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="71.13" y="389.80" width="244.17" height="54.43" as="geometry"/></mxCell><mxCell id="tab-52" value='&lt;img src="data:image/svg+xml;base64," style="width:15.5px;height:13.8px;vertical-align:-1.7px;"&gt;&amp;nbsp;&amp;nbsp;Prospective moderator (D5)' style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.8;html=1;whiteSpace=nowrap;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480.66" y="298.38" width="233.69" height="23.51" as="geometry"/></mxCell><mxCell id="num-53" value="1" style="ellipse;aspect=fixed;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12.4;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="382.41" y="329.48" width="20.49" height="20.49" as="geometry"/></mxCell><mxCell id="txt-54" value="Assesses the hostility of the candidate as an &lt;b&gt;ordinal severity&lt;/b&gt;, not as a binary label or a probability of perceived toxicity" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="404.03" y="321.37" width="412.57" height="36.72" as="geometry"/></mxCell><mxCell id="box-55" value="&lt;b&gt;Aimed at the argument&lt;/b&gt;&lt;br&gt;harshness or sarcasm: legitimate disagreement → &lt;b&gt;publish&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDEFD3;strokeColor=#4E9A3A;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontSize=12.8;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="389.80" y="367.04" width="213.70" height="58.11" as="geometry"/></mxCell><mxCell id="box-56" value="&lt;b&gt;Aimed at the person&lt;/b&gt;&lt;br&gt;the opponent becomes the object of the message → &lt;b&gt;reformulate&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6D3CF;strokeColor=#C8385A;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontSize=12.8;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600.35" y="367.04" width="213.70" height="58.11" as="geometry"/></mxCell><mxCell id="num-57" value="2" style="ellipse;aspect=fixed;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12.4;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="382.41" y="460.37" width="20.49" height="20.49" as="geometry"/></mxCell><mxCell id="txt-58" value="Reformulates the &lt;b&gt;form&lt;/b&gt; in which the premise is published, not its content · the rewrite replaces the candidate (full compliance)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="404.03" y="452.25" width="412.57" height="36.72" as="geometry"/></mxCell><mxCell id="card-59" value='&lt;img src="data:image/svg+xml;base64," style="width:11.2px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&amp;nbsp;Records kept at every turn' style="swimlane;html=1;whiteSpace=wrap;startSize=24.15;fillColor=#22385C;swimlaneFillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="59.75" y="557.67" width="494.55" height="101.05" as="geometry"/></mxCell><mxCell id="body-60" value="Candidate message · published text · decision of the moderator and its justification · pathologies detected as signals of the mechanism&lt;br&gt;The candidate remains recoverable, so the corpus can be reanalyzed under criteria not foreseen at the outset" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-59"><mxGeometry x="0.00" y="24.15" width="494.55" height="76.90" as="geometry"/></mxCell><mxCell id="card-61" value='&lt;img src="data:image/svg+xml;base64," style="width:16.0px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&amp;nbsp;Blind evaluator' style="swimlane;html=1;whiteSpace=wrap;startSize=23.75;fillColor=#22385C;swimlaneFillColor=#E3F0DA;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600.35" y="557.67" width="386.43" height="108.65" as="geometry"/></mxCell><mxCell id="body-62" value="Scores what was &lt;b&gt;published&lt;/b&gt;; the moderator scores the candidate · blind to the condition · preferably from a model family distinct from the moderator’s&lt;br&gt;&lt;i&gt;Agreement among repeated runs measures decoding stability, not the adequacy of the rubric&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-61"><mxGeometry x="0.00" y="23.75" width="386.43" height="84.90" as="geometry"/></mxCell><mxCell id="card-63" value='&lt;img src="data:image/svg+xml;base64," style="width:14.4px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&amp;nbsp;Observable in simulation' style="swimlane;html=1;whiteSpace=wrap;startSize=20.70;fillColor=#22385C;swimlaneFillColor=#E3F0DA;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="59.75" y="699.94" width="306.76" height="111.54" as="geometry"/></mxCell><mxCell id="body-64" value="Candidate and published message side by side · effect of prospective moderation estimable under controlled conditions&lt;br&gt;&lt;i&gt;Read as an upper bound, obtained under full compliance&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-63"><mxGeometry x="0.00" y="20.70" width="306.76" height="90.84" as="geometry"/></mxCell><mxCell id="card-65" value='&lt;img src="data:image/svg+xml;base64," style="width:16.0px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&amp;nbsp;Beyond the lens: open questions' style="swimlane;html=1;whiteSpace=wrap;startSize=24.95;fillColor=#22385C;swimlaneFillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="389.80" y="699.94" width="298.23" height="101.63" as="geometry"/></mxCell><mxCell id="body-66" value="Author agency and acceptance rate · direct vs. indirect effects (divergent histories) · suppression or delay of escalation · hostility as perceived by humans" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-65"><mxGeometry x="0.00" y="24.95" width="298.23" height="76.67" as="geometry"/></mxCell><mxCell id="card-67" value='&lt;img src="data:image/svg+xml;base64," style="width:16.0px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&amp;nbsp;Complementary lens' style="swimlane;html=1;whiteSpace=wrap;startSize=24.15;fillColor=#22385C;swimlaneFillColor=#DCE6F4;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="734.08" y="699.94" width="252.70" height="78.02" as="geometry"/></mxCell><mxCell id="body-68" value="Field studies with human participants capture behavior and acceptance, but not the rejected candidate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-67"><mxGeometry x="0.00" y="24.15" width="252.70" height="53.87" as="geometry"/></mxCell><mxCell id="e-69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9.0;strokeWidth=3.0;strokeColor=#8B4A2B;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;fontFamily=Helvetica;exitX=1.0000;exitY=0.6358;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.6267;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="card-34" target="card-36"><mxGeometry relative="1" as="geometry"><mxPoint x="235.63" y="172.22" as="sourcePoint"/><mxPoint x="258.92" y="172.22" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9.0;strokeWidth=3.0;strokeColor=#8B4A2B;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;fontFamily=Helvetica;exitX=1.0000;exitY=0.6283;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.4603;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="card-36" target="card-38"><mxGeometry relative="1" as="geometry"><mxPoint x="440.49" y="172.36" as="sourcePoint"/><mxPoint x="463.78" y="172.36" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e-71" value="" style="e