 e &lt;i&gt;Apolitical&lt;/i&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-46"><mxGeometry x="0.00" y="25.31" width="181.57" height="53.53" as="geometry"/></mxCell><mxCell id="card-48" value="Eixo econômico (principal)" style="swimlane;html=1;whiteSpace=wrap;startSize=23.37;fillColor=#22385C;swimlaneFillColor=#FFFFFF;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="258.92" y="210.55" width="198.64" height="77.39" as="geometry"/></mxCell><mxCell id="body-49" value="Mercado livre · Regulação estatal · Sindicatos&lt;br&gt;&lt;i&gt;contradição elimina o registro&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-48"><mxGeometry x="0.00" y="23.37" width="198.64" height="54.03" as="geometry"/></mxCell><mxCell id="card-50" value="Eixo social (secundário)" style="swimlane;html=1;whiteSpace=wrap;startSize=23.14;fillColor=#22385C;swimlaneFillColor=#FFFFFF;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="466.62" y="210.55" width="215.71" height="77.01" as="geometry"/></mxCell><mxCell id="body-51" value="Imigração · Porte de armas · Pena capital · Prioridade de valores · Religiosidade" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-50"><mxGeometry x="0.00" y="23.14" width="215.71" height="53.87" as="geometry"/></mxCell><mxCell id="card-52" value="Sinalização" style="swimlane;html=1;whiteSpace=wrap;startSize=23.42;fillColor=#22385C;swimlaneFillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="68.29" y="307.29" width="258.39" height="116.25" as="geometry"/></mxCell><mxCell id="body-53" value="Escala de 5 pontos (&lt;i&gt;Opposed&lt;/i&gt; … &lt;i&gt;Enthusiast&lt;/i&gt;) → sinal {−1, 0, +1} · &lt;i&gt;Autonomy&lt;/i&gt; e &lt;i&gt;Novelty&lt;/i&gt;: −0,5&lt;br&gt;Fora da decisão: confiança institucional, &lt;i&gt;Personal achievement&lt;/i&gt;, &lt;i&gt;Spiritual&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-52"><mxGeometry x="0.00" y="23.42" width="258.39" height="92.84" as="geometry"/></mxCell><mxCell id="card-54" value="Retido se, e somente se" style="swimlane;html=1;whiteSpace=wrap;startSize=22.71;fillColor=#22385C;swimlaneFillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="338.59" y="307.29" width="349.44" height="100.35" as="geometry"/></mxCell><mxCell id="body-55" value='(i) âncora em um dos polos&amp;emsp;&amp;emsp;(ii) &lt;i&gt;n&lt;/i&gt;&lt;span style="display:inline-block;vertical-align:-0.35em;line-height:0.95;font-size:70%;text-align:left;"&gt;contra&lt;br&gt;econ&lt;/span&gt; = 0&lt;br&gt;(iii) &lt;i&gt;n&lt;/i&gt;&lt;span style="display:inline-block;vertical-align:-0.35em;line-height:0.95;font-size:70%;text-align:left;"&gt;concord&lt;br&gt;econ&lt;/span&gt; + &lt;i&gt;n&lt;/i&gt;&lt;span style="display:inline-block;vertical-align:-0.35em;line-height:0.95;font-size:70%;text-align:left;"&gt;concord&lt;br&gt;social&lt;/span&gt; ≥ 1&amp;emsp;&amp;emsp;(iv) &lt;i&gt;n&lt;/i&gt;&lt;span style="display:inline-block;vertical-align:-0.35em;line-height:0.95;font-size:70%;text-align:left;"&gt;contra&lt;br&gt;social&lt;/span&gt; = 0&lt;br&gt;&lt;i&gt;score&lt;/i&gt; = Σ&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;s&lt;sub&gt;i&lt;/sub&gt;&lt;/i&gt; não decide: apenas ordena os elegíveis' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-54"><mxGeometry x="0.00" y="22.71" width="349.44" height="77.64" as="geometry"/></mxCell><mxCell id="tab-56" value='&lt;img src="data:image/svg+xml;base64," style="width:17.2px;height:13.8px;vertical-align:-1.7px;"&gt;&amp;nbsp;&amp;nbsp;Funil e pareamento' style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.8;html=1;whiteSpace=nowrap;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="755.98" y="178.88" width="180.97" height="23.51" as="geometry"/></mxCell><mxCell id="funnel-57" value="2.000 personas decodificadas" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DCE6F4;strokeColor=none;fontColor=#000000;fontStyle=1;fontSize=12.8;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="712.74" y="204.86" width="267.46" height="22.76" as="geometry"/></mxCell><mxCell id="funnel-58" value="399 com âncora não nula" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#CAD1DB;strokeColor=none;fontColor=#000000;fontStyle=1;fontSize=12.8;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="726.97" y="231.61" width="239.00" height="22.76" as="geometry"/></mxCell><mxCell id="funnel-59" value="121 elegíveis (101 E · 20 D)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#7A889D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="741.20" y="258.35" width="210.55" height="22.76" as="geometry"/></mxCell><mxCell id="funnel-60" value="20 selecionadas (10 por polo)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="749.73" y="285.10" width="193.48" height="22.76" as="geometry"/></mxCell><mxCell id="box-61" value='Ordenação por |&lt;i&gt;score&lt;/i&gt;| (desempate: &lt;i&gt;n&lt;/i&gt;&lt;span style="display:inline-block;vertical-align:-0.35em;line-height:0.95;font-size:70%;text-align:left;"&gt;concord&lt;br&gt;econ&lt;/span&gt; e campos não nulos) e pareamento por índice E×D&lt;br&gt;&lt;i&gt;230 descartados: 115 sem evidência · 72 por contradição econômica · 43 por contradição social&lt;/i&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22385C;strokeWidth=0.9;align=left;verticalAlign=middle;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontSize=12.8;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="714.16" y="318.67" width="269.77" height="102.81" as="geometry"/></mxCell><mxCell id="card-62" value="Camada 1 · Identidade" style="swimlane;html=1;whiteSpace=wrap;startSize=20.64;fillColor=#22385C;swimlaneFillColor=#DCE6F4;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="711.32" y="466.62" width="275.47" height="89.85" as="geometry"/></mxCell><mxCell id="body-63" value="Valores dos campos da persona: posições nos eixos econômico e social + campos de estilo (ex.: confiança institucional)&lt;br&gt;&lt;i&gt;Polo e proveniência omitidos do prompt&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-62"><mxGeometry x="0.00" y="20.64" width="275.47" height="69.21" as="geometry"/></mxCell><mxCell id="num-64" value="+" style="ellipse;aspect=fixed;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=18.0;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="681.16" y="500.20" width="23.90" height="23.90" as="geometry"/></mxCell><mxCell id="card-65" value="Camada 2 · Comportamento" style="swimlane;html=1;whiteSpace=wrap;startSize=23.23;fillColor=#22385C;swimlaneFillColor=#DCE6F4;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="335.74" y="466.62" width="340.91" height="129.30" as="geometry"/></mxCell><mxCell id="body-66" value="Patologias de Angenot: incomensurabilidade discursiva · retórica da incompreensão · ilusão da racionalidade&lt;br&gt;Turnos de 1–4 frases, registro informal · escalada progressiva · &lt;i&gt;guardrail&lt;/i&gt; identitário (ataque à identidade proibido)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-65"><mxGeometry x="0.00" y="23.23" width="340.91" height="106.07" as="geometry"/></mxCell><mxCell id="tab-67" value="Debatedores" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.8;html=1;whiteSpace=nowrap;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="124.88" y="454.87" width="111.59" height="23.51" as="geometry"/></mxCell><mxCell id="role-68" value="" style="ellipse;aspect=fixed;fillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;html=1;" vertex="1" parent="1"><mxGeometry x="97.71" y="484.67" width="49.27" height="49.27" as="geometry"/></mxCell><mxCell id="icon-69" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;editableCssRules=.*;image=data:image/svg+xml,;" vertex="1" parent="role-68"><mxGeometry x="9.63" y="12.63" width="30.00" height="24.00" as="geometry"/></mxCell><mxCell id="txt-70" value="Polo esquerda" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=12.8;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.24" y="535.08" width="104.20" height="21.36" as="geometry"/></mxCell><mxCell id="role-71" value="" style="ellipse;aspect=fixed;fillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;html=1;" vertex="1" parent="1"><mxGeometry x="214.37" y="484.67" width="49.27" height="49.27" as="geometry"/></mxCell><mxCell id="icon-72" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;editableCssRules=.*;image=data:image/svg+xml,;" vertex="1" parent="role-71"><mxGeometry x="9.63" y="12.63" width="30.00" height="24.00" as="geometry"/></mxCell><mxCell id="txt-73" value="Polo direita" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=12.8;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="196.15" y="535.08" width="85.71" height="21.36" as="geometry"/></mxCell><mxCell id="txt-74" value='&lt;span style="font-family:Courier New;font-weight:normal;"&gt;llama3.1:8b&lt;/span&gt; · &lt;i&gt;T&lt;/i&gt; = 0,7' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="107.75" y="560.08" width="145.84" height="21.36" as="geometry"/></mxCell><mxCell id="box-75" value='&lt;img src="data:image/svg+xml;base64," style="width:16.0px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&lt;b&gt;Debatedor da vez&lt;/b&gt;&lt;br&gt;recebe o histórico publicado e gera a candidata' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;align=left;verticalAlign=middle;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontSize=12.8;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="71.13" y="625.96" width="118.98" height="88.29" as="geometry"/></mxCell><mxCell id="box-76" value="&lt;b&gt;Mensagem candidata&lt;/b&gt;&lt;br&gt;turno &lt;i&gt;t&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8913A;strokeWidth=2;align=left;verticalAlign=middle;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontSize=12.8;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="204.86" y="625.96" width="83.09" height="73.13" as="geometry"/></mxCell><mxCell id="card-77" value="Célula = tema × par" style="swimlane;html=1;whiteSpace=wrap;startSize=23.37;fillColor=#22385C;swimlaneFillColor=#E3F0DA;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="71.13" y="722.70" width="244.17" height="131.59" as="geometry"/></mxCell><mxCell id="body-78" value="Temas: &lt;i&gt;Abortion&lt;/i&gt; e &lt;i&gt;Drug Legalization&lt;/i&gt; · 6 pares E×D · 8 turnos alternados (4 por persona)&lt;br&gt;Controle e tratamento compartilham tema, par, prompts e modelos: a única diferença é a presença do moderador" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-77"><mxGeometry x="0.00" y="23.37" width="244.17" height="108.23" as="geometry"/></mxCell><mxCell id="tab-79" value='&lt;img src="data:image/svg+xml;base64," style="width:15.5px;height:13.8px;vertical-align:-1.7px;"&gt;&amp;nbsp;&amp;nbsp;Moderador D5 · &lt;span style="font-family:Courier New;font-weight:normal;"&gt;qwen2.5:7b&lt;/span&gt; · &lt;i&gt;T&lt;/i&gt; = 0,3' style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.8;html=1;whiteSpace=nowrap;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="456.85" y="645.50" width="287.01" height="23.51" as="geometry"/></mxCell><mxCell id="num-80" value="1" style="ellipse;aspect=fixed;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12.4;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="382.41" y="678.31" width="20.49" height="20.49" as="geometry"/></mxCell><mxCell id="txt-81" value="Atribui um nível de hostilidade (0–4) à candidata, com o histórico" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="404.03" y="677.88" width="415.41" height="21.36" as="geometry"/></mxCell><mxCell id="num-82" value="2" style="ellipse;aspect=fixed;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12.4;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="382.41" y="701.08" width="20.49" height="20.49" as="geometry"/></mxCell><mxCell id="txt-83" value="Regra mecânica: 0–1 → publica sem alteração · ≥ 2 → reformula" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="404.03" y="700.64" width="415.41" height="21.36" as="geometry"/></mxCell><mxCell id="num-84" value="3" style="ellipse;aspect=fixed;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12.4;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="382.41" y="723.84" width="20.49" height="20.49" as="geometry"/></mxCell><mxCell id="txt-85" value="A reformulação substitui a candidata, &lt;b&gt;sem etapa de aceite do autor&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="404.03" y="723.40" width="415.41" height="21.36" as="geometry"/></mxCell><mxCell id="num-86" value="4" style="ellipse;aspect=fixed;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12.4;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="382.41" y="746.60" width="20.49" height="20.49" as="geometry"/></mxCell><mxCell id="txt-87" value="Registra justificativa e patologias · falha → publica com marcação" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.8;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="404.03" y="746.16" width="415.41" height="21.36" as="geometry"/></mxCell><mxCell id="txt-88" value="Escala ordinal de hostilidade" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=4.3;fontSize=12.4;fontColor=#000000;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="384.11" y="772.01" width="186.91" height="20.88" as="geometry"/></mxCell><mxCell id="num-89" value="0" style="ellipse;aspect=fixed;fillColor=#5AAE4E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.0;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="413.70" y="793.26" width="26.18" height="26.18" as="geometry"/></mxCell><mxCell id="txt-90" value="Sem hostilidade" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=11.6;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="377.00" y="820.64" width="99.58" height="19.92" as="geometry"/></mxCell><mxCell id="num-91" value="1" style="ellipse;aspect=fixed;fillColor=#A9C94A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.0;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="504.75" y="793.26" width="26.18" height="26.18" as="geometry"/></mxCell><mxCell id="txt-92" value="Tom ríspido" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=11.6;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="468.05" y="820.64" width="99.58" height="19.92" as="geometry"/></mxCell><mxCell id="num-93" value="2" style="ellipse;aspect=fixed;fillColor=#F2C94C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.0;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="595.80" y="793.26" width="26.18" height="26.18" as="geometry"/></mxCell><mxCell id="txt-94" value="Ironia ou&lt;br&gt;caricatura" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=11.6;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="559.10" y="820.64" width="99.58" height="33.84" as="geometry"/></mxCell><mxCell id="num-95" value="3" style="ellipse;aspect=fixed;fillColor=#EE8A3C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.0;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="686.85" y="793.26" width="26.18" height="26.18" as="geometry"/></mxCell><mxCell id="txt-96" value="Deslegitimação" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=11.6;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650.15" y="820.64" width="99.58" height="19.92" as="geometry"/></mxCell><mxCell id="num-97" value="4" style="ellipse;aspect=fixed;fillColor=#D7443E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14.0;html=1;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="777.90" y="793.26" width="26.18" height="26.18" as="geometry"/></mxCell><mxCell id="txt-98" value="Ataque pessoal" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=11.6;fontColor=#000000;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="741.20" y="820.64" width="99.58" height="19.92" as="geometry"/></mxCell><mxCell id="e-99" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#C8385A;dashed=1;dashPattern=3 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="563.37" y="788.14" as="sourcePoint"/><mxPoint x="563.37" y="842.20" as="targetPoint"/></mxGeometry></mxCell><mxCell id="txt-100" value="limiar ≥ 2: o alvo da hostilidade migra do argumento para a pessoa" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;spacingLeft=1.5;fontSize=12.0;fontColor=#C8385A;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="401.79" y="847.89" width="397.13" height="20.40" as="geometry"/></mxCell><mxCell id="box-101" value='&lt;img src="data:image/svg+xml;base64," style="width:14.4px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&lt;b&gt;Texto publicado&lt;/b&gt;&lt;br&gt;entra no histórico do debate' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E9A3A;strokeWidth=2;align=left;verticalAlign=middle;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontSize=12.8;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="853.58" y="625.96" width="131.46" height="73.13" as="geometry"/></mxCell><mxCell id="card-102" value='&lt;img src="data:image/svg+xml;base64," style="width:11.2px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&amp;nbsp;Registro por turno (gravação incremental em disco)' style="swimlane;html=1;whiteSpace=wrap;startSize=24.27;fillColor=#22385C;swimlaneFillColor=#FBE3D0;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="59.75" y="967.39" width="494.55" height="99.58" as="geometry"/></mxCell><mxCell id="body-103" value="Mensagem candidata · texto publicado · nota e decisão do moderador · justificativa · patologias detectadas · 3 notas do juiz&lt;br&gt;Manifesto de cada execução com &lt;i&gt;hash&lt;/i&gt; criptográfico dos prompts · execução interrompida deixa registro parcial identificável" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-102"><mxGeometry x="0.00" y="24.27" width="494.55" height="75.31" as="geometry"/></mxCell><mxCell id="card-104" value='&lt;img src="data:image/svg+xml;base64," style="width:16.0px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&amp;nbsp;Juiz cego · &lt;span style="font-family:Courier New;font-weight:normal;"&gt;gemma2:9b&lt;/span&gt; · &lt;i&gt;T&lt;/i&gt; = 0,0' style="swimlane;html=1;whiteSpace=wrap;startSize=25.00;fillColor=#22385C;swimlaneFillColor=#E3F0DA;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600.35" y="967.39" width="386.43" height="129.22" as="geometry"/></mxCell><mxCell id="body-105" value="Pontua cada mensagem &lt;b&gt;publicada&lt;/b&gt; na mesma escala 0–4 · 3 execuções → mediana (as 3 notas são preservadas)&lt;br&gt;Recebe a mensagem e o histórico; cego à condição, às personas e à moderação; sem acesso à candidata&lt;br&gt;&lt;i&gt;Moderador ≠ juiz: famílias de modelos distintas; um avalia a candidata, o outro o texto publicado&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-104"><mxGeometry x="0.00" y="25.00" width="386.43" height="104.21" as="geometry"/></mxCell><mxCell id="tab-106" value="Seleção do corpus (filtros em sequência; cada exclusão é registrada)" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#22385C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13.8;html=1;whiteSpace=nowrap;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="93.30" y="1117.82" width="482.03" height="23.51" as="geometry"/></mxCell><mxCell id="card-107" value="1. Elegibilidade" style="swimlane;html=1;whiteSpace=wrap;startSize=23.28;fillColor=#22385C;swimlaneFillColor=#FFFFFF;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="68.29" y="1149.49" width="168.48" height="61.75" as="geometry"/></mxCell><mxCell id="body-108" value="debate completo: 8 turnos, uma nota por turno" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-107"><mxGeometry x="0.00" y="23.28" width="168.48" height="38.47" as="geometry"/></mxCell><mxCell id="card-109" value="2. Identidade de prompt" style="swimlane;html=1;whiteSpace=wrap;startSize=23.28;fillColor=#22385C;swimlaneFillColor=#FFFFFF;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="251.52" y="1149.49" width="168.48" height="81.07" as="geometry"/></mxCell><mxCell id="body-110" value="mesma versão dos prompts (&lt;i&gt;hash&lt;/i&gt; do manifesto)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-109"><mxGeometry x="0.00" y="23.28" width="168.48" height="57.79" as="geometry"/></mxCell><mxCell id="card-111" value="3. Integridade do par" style="swimlane;html=1;whiteSpace=wrap;startSize=23.28;fillColor=#22385C;swimlaneFillColor=#FFFFFF;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="434.76" y="1149.49" width="168.48" height="81.15" as="geometry"/></mxCell><mxCell id="body-112" value="controle e tratamento da célula entram ou saem juntos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-111"><mxGeometry x="0.00" y="23.28" width="168.48" height="57.87" as="geometry"/></mxCell><mxCell id="card-113" value="Corpus" style="swimlane;html=1;whiteSpace=wrap;startSize=23.23;fillColor=#22385C;swimlaneFillColor=#DCE6F4;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="631.65" y="1129.57" width="167.34" height="129.30" as="geometry"/></mxCell><mxCell id="body-114" value="60 execuções registradas → corpus completo: 42 debates (11 células, 21 réplicas) → &lt;b&gt;desenho balanceado&lt;/b&gt;: 20 debates (10 células, 5 por tema)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-113"><mxGeometry x="0.00" y="23.23" width="167.34" height="106.07" as="geometry"/></mxCell><mxCell id="card-115" value='&lt;img src="data:image/svg+xml;base64," style="width:12.8px;height:12.8px;vertical-align:-1.6px;"&gt;&amp;nbsp;&amp;nbsp;Métricas (Seção V)' style="swimlane;html=1;whiteSpace=wrap;startSize=23.51;fillColor=#22385C;swimlaneFillColor=#DCE6F4;strokeColor=#22385C;strokeWidth=0.9;fontColor=#FFFFFF;fontStyle=1;fontSize=12.8;collapsible=0;swimlaneLine=0;rounded=0;container=1;align=left;spacing=0;spacingLeft=6.4;spacingRight=6.4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="810.90" y="1129.57" width="175.88" height="142.38" as="geometry"/></mxCell><mxCell id="body-116" value="Hostilidade média por condição · diferença pareada por célula · trajetória por turno · distribuição das notas · acionamento do moderador" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.8;spacing=0;spacingLeft=6.4;spacingRight=6.4;spacingTop=3;fontColor=#000000;overflow=visible;fontFamily=Helvetica;" vertex="1" parent="card-115"><mxGeometry x="0.00" y="23.51" width="175.88" height="118.87" as="geometry"/></mxCell><mxCell id="e-117" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=9.0;strokeWidth=3.0;strokeColor=#8B4A2B;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;fontFamily=Helvetica;exitX=1.0000;exitY=0.6046;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.4931;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="card-18" target="card-20"><mxGeometry relative="1" as="geometry"><mxP