@inproceedings{schneiderAImediatedCollaborativeCrowdsourcing2025,
  title = {{{AI-mediated Collaborative Crowdsourcing}} for {{Social News Curation}}: {{The Case}} of {{Acropolis}}},
  shorttitle = {{{AI-mediated Collaborative Crowdsourcing}} for {{Social News Curation}}},
  booktitle = {Proceedings of the 2025 {{ACM International Conference}} on {{Interactive Media Experiences}}},
  author = {Schneider, Daniel and Chaves, Ramon and Pimentel, Ana Paula and {de Almeida}, Marcos Antonio and De Souza, Jano Moreira and Correia, Ant{\'o}nio},
  year = 2025,
