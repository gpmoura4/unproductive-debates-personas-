  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3706370.3731644},
  urldate = {2026-05-06},
  abstract = {Collaborative crowdsourcing has evolved over recent years as a problem-solving model that builds on interactions that take place within crowds or self-organizing teams that form and dissolve in response to an open call. Unlike microtasking, its effectiveness depends primarily on collective actions rather than individual efforts, particularly for non-decomposable tasks that require a certain level of interdependency. Although social news curation has gained attention as a means of empowering both citizens and journalists, there is a need to understand the components and constraints that shape this online crowdsourcing activity when mediated by artificial intelligence (AI). In response to this gap, this paper reimagines the traditional social news curation model through a design fiction prototype consisting of a personalized AI system and user-driven social curation activities. In a highly polarized opinion and political climate where propaganda, misinformation, and extreme polarization take on a dominant framing to generate social chaos, the envisioned solution seeks to model healthy and trustworthy socio-algorithmic interactions towards a more democratic and relevant form of news curation.},
  isbn = {979-8-4007-1391-0},
  file = {C:\Users\luizf\Zotero\storage\6FGWH4KT\Schneider et al. - 2025 - AI-mediated Collaborative Crowdsourcing for Social News Curation The Case of Acropolis.pdf}
}

@article{suranFrameworksCollectiveIntelligence2021,
  title = {Frameworks for {{Collective Intelligence}}: {{A Systematic Literature Review}}},
  shorttitle = {Frameworks for {{Collective Intelligence}}},
  author = {Suran, Shweta and Pattanaik, Vishwajeet and Draheim, Dirk},
  year = 2021,
  month = jan,
  journal = {ACM Computing Surveys},
  volume = {53},
